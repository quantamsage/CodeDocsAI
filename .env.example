# CodeDocs AI configuration. All variables are optional; defaults shown.
# The application reads these from the process environment.

# "development" or "production" (production enables HSTS and static asset caching).
APP_ENV=development

# Address the HTTP server listens on.
APP_ADDR=:8080

# Root directory for application data (database, uploads).
APP_DATA_DIR=data

# SQLite database file. Defaults to $APP_DATA_DIR/app.db.
# APP_DATABASE_PATH=data/app.db

# debug | info | warn | error
APP_LOG_LEVEL=info

# text | json
APP_LOG_FORMAT=text

# Maximum time allowed for graceful shutdown.
APP_SHUTDOWN_TIMEOUT=15s

# Absolute lifetime of a login session (Go duration, e.g. 168h = 7 days).
APP_SESSION_LIFETIME=168h

# A session unused for this long ends early. Must not exceed APP_SESSION_LIFETIME.
APP_SESSION_IDLE_TIMEOUT=24h

# --- Code uploads -----------------------------------------------------------
# Sizes accept bytes or a KiB/MiB/GiB (or KB/MB/GB) suffix.

# Largest accepted upload request (all files in one submission, compressed ZIPs included).
APP_UPLOAD_MAX_REQUEST_SIZE=100MiB

# Largest single file that is stored (uncompressed). Larger files are rejected or skipped.
APP_UPLOAD_MAX_FILE_SIZE=2MiB

# Most files a project may hold.
APP_UPLOAD_MAX_FILES=5000

# Largest total size of a project's files, and of the data extracted from one ZIP archive.
APP_UPLOAD_MAX_TOTAL_SIZE=200MiB

# ZIP entries that expand more than this many times their compressed size are rejected.
APP_UPLOAD_MAX_COMPRESSION_RATIO=100

# Maximum time for receiving and processing one upload.
APP_UPLOAD_TIMEOUT=10m

# --- AI (code analysis and documentation) -----------------------------------
# Claude API key from https://platform.claude.com/ (required for analysis).
ANTHROPIC_API_KEY=

# Model and reasoning effort (low | medium | high | xhigh | max).
APP_AI_MODEL=claude-opus-5-5
APP_AI_EFFORT=medium

# Maximum time for one AI request.
APP_AI_TIMEOUT=5m

# Approximate input tokens per analysis request; files are grouped or split to fit.
APP_AI_BATCH_TOKENS=40000

# Background jobs (analysis, documentation) run at the same time.
APP_JOB_WORKERS=2
